OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=llama3.1:8b
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=120
DOCLING_BASE_URL=http://docling:5001
QDRANT_BASE_URL=http://qdrant:6333
RAG_COLLECTION_NAME=platform_documents
RAG_INGESTION_TIMEOUT_SECONDS=120
# Provisional cap; adjust after measuring target-host Qdrant storage growth.
RAG_MAX_INDEXED_CHUNKS=25000
# Provisional threshold for initial use; calibrate before treating it as final.
RAG_SCORE_THRESHOLD=0.5
# Optional practical page limit; set after target-host benchmarking.
RAG_MAX_PDF_PAGES=100
